+test('hosted import refreshes reference stock without rewriting protected physical-count cells', () => {
+  const { context } = makeContext();
+  const target = {};
+  context.bigsellerReadDriveFileValues_ = () => [['SKU Name'], ['sku-1']];
+  context.bigsellerKeepSingleSkuRows_ = values => values;
+  context.warehouseReadMerchantCodeIndex_ = () => ({});
+  context.warehouseBuildLeanBigsellerSnapshot_ = values => values;
+  context.SpreadsheetApp = { openById: () => ({}) };
+  context.getRequiredStockSheet_ = () => target;
+  let replaced = false;
+  context.warehouseReplaceBigsellerSnapshot_ = (sheet, values) => { assert.equal(sheet, target); replaced = true; };
+  context.bigsellerAdvanceSourceWatermark_ = () => null;
+  context.warehouseSyncMerchantCodes_ = () => { throw Error('Physical-count merchant cells are protected'); };
+  context.warehouseEnsurePhysicalCountSystemStockFormula_ = () => { throw Error('Physical-count formulas are protected'); };
+  context.invalidateDashboardModuleCache_ = () => {};
+  context.procBuildId_ = () => 'import-1';
+  context.procTimezone_ = () => 'Asia/Singapore';
+  context.procGetControlSpreadsheet_ = () => ({});
+  context.procEnsureControlSheets_ = () => ({ imports: {}, activity: {} });
+  context.procAppendRows_ = () => {};
+  context.procCurrentActor_ = () => 'runner';
+  context.procLogActivity_ = () => {};
+  context.procFormatDateTime_ = () => '2026-10-16 18:00';
+  const result = context.bigsellerImportDriveFile_({ getId: () => 'file-1', getName: () => 'inventory.csv' });
+  assert.equal(replaced, true);
+  assert.equal(result.rows, 1);
+});
