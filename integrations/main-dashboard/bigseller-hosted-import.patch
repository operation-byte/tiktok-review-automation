+test('technical failures stay in logs and do not send to the Procurement group', () => {
+  const { context } = makeContext();
+  const logs = [];
+  context.Logger = { log: message => logs.push(message) };
+  context.bigsellerSendTelegram_ = () => { throw Error('Group must not be notified'); };
+  context.bigsellerSendAutomationFailure_('Protected cell during refresh');
+  assert.equal(logs.length, 1);
+  assert.match(logs[0], /Protected cell/);
+});
